# Backend origin for dm-api. No trailing slash, no /api/v1 — lib/dm-api.ts
# appends that. NEXT_PUBLIC_ is required: these calls run in the browser and
# Next only inlines that prefix into the client bundle, at BUILD time — change
# this and you must rebuild, not just restart.
#
# Cutover: point this at the deployed dm-api Worker.
#   dm-api (new):    https://dm-api.<subdomain>.workers.dev
#   dm-backend (old): https://srv.digitalmadrasa.co.in
NEXT_PUBLIC_API_BASE_URL=https://srv.digitalmadrasa.co.in
